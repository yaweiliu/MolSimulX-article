Neighbor list builds = 0
Dangerous builds = 0
unfix           freecof
reset_timestep  0

# SPC/E：Ow–Hw（bond 12）+ H–O–H（angle 17）；COF 含 H 键 5/7/9 一并 SHAKE
# 注意：SO3 的 s6-o 勿缺键，否则未成键 O 会在第 1 步被斥飞 → Bond atoms missing
fix             myshake  all  shake  0.0001  20  0  b  5  7  9  12
Finding SHAKE clusters ...
      90 = # of size 2 clusters
    1060 = # of size 3 clusters
       0 = # of size 4 clusters
       0 = # of frozen angles
  find clusters CPU = 0.000 seconds

# ----- 分组：骨架 C/N 弹簧钉扎（仍参与热浴 / 积分，可动）-----
# type：2=N(nu), 3–5=C；水 Hw/Ow=10/11，Na=12。若 data.lmp 编号不同请改
group           backbone  type  2  3  4  5
420 atoms in group backbone
fix             pinbb  backbone  spring/self  ${Kspring}
fix             pinbb  backbone  spring/self  100

# ----- 热力学 -----
thermo_style    custom  step  time  temp  press  pzz  lx  ly  lz  density
thermo_modify   flush yes
thermo          ${thermo_every}
thermo          1000

# ----- 初速度 -----
velocity        all  create  ${mytemp}  ${myrand}  dist gaussian  mom yes  rot yes
velocity        all  create  300  ${myrand}  dist gaussian  mom yes  rot yes
velocity        all  create  300  58938  dist gaussian  mom yes  rot yes

write_data      result_atoms.data  nofix
System init for write_data ...
Generated 66 of 66 mixed pair_coeff terms from arithmetic mixing rule

# =============================================================================
# 0. NVT 预松弛：0.2 fs × 5000（≈ 1 ps）
#    部分键角（如 -SO3 的 O–S–O）与平衡角差较大，小步长先缓和高力
# =============================================================================

timestep        0.5                                      # [fs]
fix             mynvt  all  nvt  temp  ${mytemp}  ${mytemp}  ${tdamp}
fix             mynvt  all  nvt  temp  300  ${mytemp}  ${tdamp}
fix             mynvt  all  nvt  temp  300  300  ${tdamp}
fix             mynvt  all  nvt  temp  300  300  100
run             ${nvt_pre_steps}
run             5000
Generated 66 of 66 mixed pair_coeff terms from arithmetic mixing rule
