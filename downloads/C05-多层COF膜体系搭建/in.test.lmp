# created by msxbox

variable myrand    equal 58938
variable mytemp    equal 300.0
variable mypress   equal 1.0

units real
boundary p p p

atom_style full
bond_style harmonic
angle_style harmonic
dihedral_style fourier

special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333
pair_style lj/cut/coul/cut 8.0
pair_modify mix arithmetic shift yes


read_data data.lmp

pair_coeff    1    1     0.146300     3.048121  # o
pair_coeff    2    2     0.154500     3.279042  # nu
pair_coeff    3    3     0.098800     3.315212  # c
pair_coeff    4    4     0.098800     3.315212  # ca
pair_coeff    5    5     0.098800     3.315212  # ce
pair_coeff    6    6     0.016100     2.625479  # ha
pair_coeff    7    7     0.016100     2.536389  # h4
pair_coeff    8    8     0.010000     1.106496  # hn
pair_coeff    9    9     0.061400     4.058400  # s6


# 能量最小化
minimize 0.0 1.0e-8 1000 100000
reset_timestep 0
fix myshake all shake 0.0001 20 0 b 5 7 9

variable t_ps equal time/1000

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

timestep 1.0

velocity all create ${mytemp} ${myrand} dist gaussian mom yes rot yes

# ---- 全部骨架 C/N：spring/self 拉回各自初始位置 ----
# type：2=nu(N), 3–5=c/ca/ce(C)；若你的 data.lmp 编号不同请改
group backbone type 2 3 4 5
fix pinbb backbone spring/self 100.0

thermo_style custom step v_t_ps temp pe ke etotal press vol density
thermo_modify flush yes
thermo 100

dump traj all xyz 1000 result_atoms.xyz
dump_modify traj element O N C C C H H H S sort id

# NVE 测试（能量守恒）
fix nve all nve
run 10000
unfix nve

# NVT 测试（控温）
fix nvt all nvt temp ${mytemp} ${mytemp} 100
run 20000
unfix nvt

undump traj
