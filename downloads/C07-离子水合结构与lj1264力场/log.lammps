LAMMPS (4 Jul 2026 - Development - patch_4Jul2026-178-gc4fe7a5bcf)
# =============================================================================
# MgCl2(aq) + SPC/E，Li/Merz 12-6-4（C4 table overlay）
# -----------------------------------------------------------------------------
# 体系：data.lmp — 2 Mg²⁺ + 4 Cl⁻ + 800 SPC/E（type 1=Mg, 2=Cl, 3=Hw, 4=Ow）
# 势：  lj/cut/coul/long 12 Å + PPPM；hybrid/overlay 叠
#       C4_Mg_Ow.table / C4_Cl_Ow.table（section C4_POT；E=-C4/r^4）
# 流程：最小化 → 预松弛 → NVT 100 ps + NPT 400 ps（共 500 ps）→ NPT 生产 1 ns
# 轨迹：生产段 500 帧 unwrap（xsu ysu zsu）→ result_atoms.lammpstrj
#
# 注意：hybrid/overlay 下须显式写齐全部 I–J 的 lj/cut/coul/long（勿只靠 mix）。
# =============================================================================

# ----- 可调参数 -----
variable        myrand          equal   58938
variable        mytemp          equal   298.0           # [K]
variable        mypress         equal   1.0             # [atm]
variable        tdamp           equal   100.0           # [fs]
variable        pdamp           equal   1000.0          # [fs]

variable        nvt_pre_steps   equal   4000            # 0.5 fs × 4000 = 2 ps
variable        nvt_steps       equal   100000          # NVT 100 ps @ 1 fs
variable        npt_eq_steps    equal   400000          # NPT 400 ps
variable        prod_steps      equal   1000000         # 1 ns
variable        dump_every      equal   2000            # 500 frames
variable        thermo_every    equal   1000

# ----- 基本设置 -----
units           real
boundary        p p p

atom_style      full
bond_style      harmonic
angle_style     harmonic
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333

pair_style      hybrid/overlay                 lj/cut/coul/long 12.0 12.0                 table linear 1000
# hybrid 下 I–J 已全部显式给出，不再依赖 mix
pair_modify     shift yes
kspace_style    pppm  1.0e-5

read_data       data.lmp
Reading data file ...
  orthogonal box = (-20 -20 -20) to (20 20 20)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  2406 atoms
  scanning bonds ...
  1 = max bonds/atom
  scanning angles ...
  1 = max angles/atom
  orthogonal box = (-20 -20 -20) to (20 20 20)
  1 by 2 by 2 MPI processor grid
  reading bonds ...
  1600 bonds
  reading angles ...
  800 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0.5     
  special bond factors coul:  0        0        0.8333  
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.015 seconds

# LJ：ε [kcal/mol]，σ [Å]；type 1=Mg, 2=Cl, 3=Hw, 4=Ow
pair_coeff      1 1 lj/cut/coul/long   0.020934   2.546189   # Mg-Mg
pair_coeff      1 2 lj/cut/coul/long   0.104739   3.191199   # Mg-Cl
pair_coeff      1 3 lj/cut/coul/long   0.000000   1.273094   # Mg-Hw
pair_coeff      1 4 lj/cut/coul/long   0.057018   2.856094   # Mg-Ow
pair_coeff      2 2 lj/cut/coul/long   0.524046   3.836210   # Cl-Cl
pair_coeff      2 3 lj/cut/coul/long   0.000000   1.918105   # Cl-Hw
pair_coeff      2 4 lj/cut/coul/long   0.285279   3.501105   # Cl-Ow
pair_coeff      3 3 lj/cut/coul/long   0.000000   0.000000   # Hw-Hw
pair_coeff      3 4 lj/cut/coul/long   0.000000   1.583000   # Hw-Ow
pair_coeff      4 4 lj/cut/coul/long   0.155300   3.166000   # Ow-Ow

# C4 overlay（仅离子–水氧；与上面 lj 叠加）
pair_coeff      1 4 table C4_Mg_Ow.table C4_POT
Reading pair table potential file C4_Mg_Ow.table with DATE: generated
pair_coeff      2 4 table C4_Cl_Ow.table C4_POT
Reading pair table potential file C4_Cl_Ow.table with DATE: generated

neighbor        2.0  bin
neigh_modify    delay 0  every 1  check yes
# 截断 12 + skin 2；略放大 ghost，减轻多核 PPPM out-of-range
comm_modify     cutoff 15.0

# ----- 能量最小化（先消重叠，再给速度）-----
minimize        1.0e-4  1.0e-6  10000  100000
