# =============================================================================
# 平衡：NVT 100 ps + NPT(iso) 400 ps = 500 ps（不含上面 2 ps 预松弛）
# =============================================================================

timestep        1.0
fix             mynvt  all  nvt  temp  ${mytemp}  ${mytemp}  ${tdamp}
fix             mynvt  all  nvt  temp  298  ${mytemp}  ${tdamp}
fix             mynvt  all  nvt  temp  298  298  ${tdamp}
fix             mynvt  all  nvt  temp  298  298  100
run             ${nvt_steps}
run             100000
