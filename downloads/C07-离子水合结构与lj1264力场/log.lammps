thermo_style    custom  step  time  temp  press  lx  ly  lz  density  vol  pe  ke
thermo_modify   flush yes
thermo          ${thermo_every}
thermo          1000

velocity        all  create  ${mytemp}  ${myrand}  dist gaussian  mom yes  rot yes
velocity        all  create  298  ${myrand}  dist gaussian  mom yes  rot yes
velocity        all  create  298  58938  dist gaussian  mom yes  rot yes

write_data      result_atoms.data  nofix
