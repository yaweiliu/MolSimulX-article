Generated 1 of 1 mixed pair_coeff terms from arithmetic mixing rule

# =============================================================================
# 生产段：继续 NPT 2 ns
#   - 疏轨迹全程 → 平动扩散（unwrap）
#   - 密轨迹仅开头 rot_steps → 转动扩散（控文件体积）
#   - 应力自相关全程 → 粘度（Green–Kubo）
# =============================================================================

# ----- 平动轨迹（疏，全程）：xsu/ysu/zsu 为 unwrap 分数坐标 -----
dump            dump_trans  all  custom  ${dump_trans_every}                  result_traj_trans.lammpstrj  id  mol  type  xsu  ysu  zsu
dump            dump_trans  all  custom  500                  result_traj_trans.lammpstrj  id  mol  type  xsu  ysu  zsu
dump_modify     dump_trans  sort id

# ----- 转动轨迹（密，短窗口）：取向衰减快，不必存满 2 ns -----
dump            dump_rot  all  custom  ${dump_rot_every}                  result_traj_rot.lammpstrj  id  mol  type  xsu  ysu  zsu
dump            dump_rot  all  custom  20                  result_traj_rot.lammpstrj  id  mol  type  xsu  ysu  zsu
dump_modify     dump_rot  sort id

# ----- Green–Kubo 粘度：非对角应力自相关 -----
#   η = (V / k_B T) ∫ <P_αβ(0) P_αβ(t)> dt ，三剪切分量平均
#   units real：P [atm]，V [Å³]，t [fs] → 换算到 Pa·s，再 ×1000 得 cP
variable        pxy             equal   pxy
variable        pxz             equal   pxz
variable        pyz             equal   pyz

fix             visc_corr  all  ave/correlate  ${corr_nevery}  ${corr_nrepeat}  ${corr_nfreq}                  v_pxy  v_pxz  v_pyz  type auto  file result_viscosity_correlate.dat                  ave running
fix             visc_corr  all  ave/correlate  5  ${corr_nrepeat}  ${corr_nfreq}                  v_pxy  v_pxz  v_pyz  type auto  file result_viscosity_correlate.dat                  ave running
fix             visc_corr  all  ave/correlate  5  400  ${corr_nfreq}                  v_pxy  v_pxz  v_pyz  type auto  file result_viscosity_correlate.dat                  ave running
fix             visc_corr  all  ave/correlate  5  400  2000                  v_pxy  v_pxz  v_pyz  type auto  file result_viscosity_correlate.dat                  ave running

variable        kB              equal   1.380649e-23    # [J/K]
variable        atm2Pa          equal   101325.0
variable        A3_to_m3        equal   1.0e-30
variable        fs_to_s         equal   1.0e-15
variable        convert         equal   ${atm2Pa}*${atm2Pa}*${A3_to_m3}*${fs_to_s}
variable        convert         equal   101325*${atm2Pa}*${A3_to_m3}*${fs_to_s}
variable        convert         equal   101325*101325*${A3_to_m3}*${fs_to_s}
variable        convert         equal   101325*101325*1e-30*${fs_to_s}
variable        convert         equal   101325*101325*1e-30*1e-15
# trap 积的是相关函数；再乘采样间隔 corr_nevery*dt 与单位换算
variable        scale           equal   vol*${convert}/(${kB}*${mytemp})*${corr_nevery}*dt
variable        scale           equal   vol*1.0266755625e-35/(${kB}*${mytemp})*${corr_nevery}*dt
variable        scale           equal   vol*1.0266755625e-35/(1.380649e-23*${mytemp})*${corr_nevery}*dt
variable        scale           equal   vol*1.0266755625e-35/(1.380649e-23*300)*${corr_nevery}*dt
variable        scale           equal   vol*1.0266755625e-35/(1.380649e-23*300)*5*dt
variable        eta_xy          equal   trap(f_visc_corr[3])*${scale}
variable        eta_xy          equal   trap(f_visc_corr[3])*1.89164470263451e-10
variable        eta_xz          equal   trap(f_visc_corr[4])*${scale}
variable        eta_xz          equal   trap(f_visc_corr[4])*1.89164470263451e-10
variable        eta_yz          equal   trap(f_visc_corr[5])*${scale}
variable        eta_yz          equal   trap(f_visc_corr[5])*1.89164470263451e-10
variable        viscosity_Pas   equal   (v_eta_xy+v_eta_xz+v_eta_yz)/3.0
variable        viscosity_cP    equal   v_viscosity_Pas*1000.0

# thermo 必须与 corr_nfreq 对齐：ave/correlate 只在 Nfreq 倍数步更新，
# 若 thermo 更密（如 1000）会报 Fix in variable not computed at compatible time
thermo_style    custom  step  time  temp  press  density  vol  v_viscosity_cP
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/output.cpp:1100)
thermo_modify   flush yes
thermo          ${corr_nfreq}
thermo          2000

# ----- 生产前段：疏+密轨迹同时开 -----
run             ${rot_steps}
run             200000
