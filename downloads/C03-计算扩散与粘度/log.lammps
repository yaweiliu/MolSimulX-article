LAMMPS (4 Jul 2026 - Development - patch_4Jul2026-178-gc4fe7a5bcf)
# =============================================================================
# SPC/E 体相水：粘度（Green–Kubo）+ 平动/转动扩散用轨迹
# -----------------------------------------------------------------------------
# 体系：约 500 个 SPC/E（data.lmp：type 1 = Hw，type 2 = Ow）
# 流程：最小化 → NVT+NPT 平衡共 500 ps → NPT 生产 2 ns
# 生产段：
#   1) fix ave/correlate 应力相关 → 粘度 η（GK）——全程 2 ns
#   2) 疏轨迹 result_traj_trans.*  → 质心 MSD → 平动 D（全程 2 ns）
#   3) 密轨迹 result_traj_rot.*    → 取向 / 角 MSD → 转动 D_r（仅开头短窗口）
# =============================================================================

# ----- 可调参数 -----
variable        myrand          equal   58938           # 速度初始化随机种子
variable        mytemp          equal   300.0           # 目标温度 [K]
variable        mypress         equal   1.0             # 目标压力 [atm]
variable        tdamp           equal   100.0           # 热浴耦合 [fs]
variable        pdamp           equal   1000.0          # 压浴耦合 [fs]

# 平衡 / 生产时长（timestep = 1 fs）
variable        nvt_steps       equal   100000          # NVT 平衡 100 ps
variable        npt_eq_steps    equal   400000          # NPT 平衡 400 ps（与上合计 500 ps）
variable        prod_steps      equal   2000000         # NPT 生产总长 2 ns
variable        rot_steps       equal   200000          # 密轨迹只写开头 200 ps（水转动衰减快）

# 轨迹间隔（步）；平动疏、转动密
variable        dump_trans_every equal  500             # 0.5 ps → 质心 MSD
variable        dump_rot_every   equal  20              # 20 fs  → 取向 / 角 MSD

# Green–Kubo 粘度：采样间隔 × 相关长度 = 相关时间窗
#   窗长 = corr_nevery * corr_nrepeat * dt = 5*400*1 fs = 2 ps
variable        corr_nevery     equal   5
variable        corr_nrepeat    equal   400
variable        corr_nfreq      equal   2000            # 须能被 nevery*nrepeat 整除
variable        prod_rest       equal   ${prod_steps}-${rot_steps}
variable        prod_rest       equal   2000000-${rot_steps}
variable        prod_rest       equal   2000000-200000

# ----- 基本设置 -----
units           real
boundary        p p p

atom_style      full
bond_style      harmonic
angle_style     harmonic
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333

pair_style      lj/cut/coul/long  10.0  10.0
pair_modify     mix arithmetic  shift yes
kspace_style    pppm  1.0e-5

read_data       data.lmp
