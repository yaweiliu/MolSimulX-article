unfix           mynvt

# ----- 2. NPT 平衡（收密度）-----
fix             mynpt  all  npt  temp  ${mytemp}  ${mytemp}  ${tdamp}                  iso  ${mypress}  ${mypress}  ${pdamp}
fix             mynpt  all  npt  temp  300  ${mytemp}  ${tdamp}                  iso  ${mypress}  ${mypress}  ${pdamp}
