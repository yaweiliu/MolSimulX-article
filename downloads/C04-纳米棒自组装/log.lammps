Dangerous builds = 0
reset_timestep  0

# ----- 分组 / 刚体 / 热浴（贯穿全程）-----
group           rods    type  1
9537 atoms in group rods

fix             rigid   rods  rigid/small  molecule
Fix rigid/small setup ...
  create bodies CPU = 0.001 seconds
  867 rigid bodies with 9537 atoms
  2.5000007 = max distance from body owner to body atom
fix             lang    all   langevin  ${mytemp}  ${mytemp}  1.0  ${myrand}  zero yes
fix             lang    all   langevin  1  ${mytemp}  1.0  ${myrand}  zero yes
fix             lang    all   langevin  1  1  1.0  ${myrand}  zero yes
fix             lang    all   langevin  1  1  1.0  4003  zero yes

# ----- 热力学（写入默认 log.lammps）-----
thermo_style    custom  step  time  temp  press  pxx  pyy  pzz  lx  ly  lz  vol  density
thermo_modify   flush yes
thermo          ${thermo_every}
thermo          1000

# ----- 初速度 -----
velocity        all  create  ${mytemp}  ${myrand}  rot yes  dist gaussian  mom yes
velocity        all  create  1  ${myrand}  rot yes  dist gaussian  mom yes
velocity        all  create  1  4003  rot yes  dist gaussian  mom yes
WARNING: Cannot count rigid body degrees-of-freedom before bodies are fully initialized (src/RIGID/fix_rigid_small.cpp:1082)

write_data      result_atoms.data  nofix  nocoeff
System init for write_data ...
Generated 0 of 0 mixed pair_coeff terms from geometric mixing rule

# =============================================================================
# 1. NVT：刚体 + Langevin，盒边固定（热化 / 打散局部应力）
# =============================================================================

run             ${nvt_steps}
run             100000
